# Pick ONE provider. Gemini has a free tier (https://aistudio.google.com/apikey), so it's the cheap option.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash        # or gemini-2.5-flash-lite for the largest free quota

# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# One or more device tokens (comma separated). Generate with: openssl rand -hex 24
APP_TOKENS=
JAMENDO_CLIENT_ID=
PORT=8787
